{
  "name": "arpg",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "package": "npm run typecheck && node scripts/package-portable.mjs",
    "docs:models": "node scripts/render-monster-models.mjs",
    "docs:combos": "node scripts/render-combo-doc.mjs",
    "docs:icons": "vite build -c scripts/vite.item-icons.config.ts",
    "docs:sim": "vite build -c scripts/vite.sim.config.ts",
    "docs:cores": "node scripts/render-core-codex.mjs",
    "docs:pages": "node scripts/publish-design-docs.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.logic.json",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "lint": "npm run typecheck && npm run lint:deps"
  },
  "dependencies": {
    "pixi.js": "^8.21.0",
    "vue": "^3.5.43",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "dependency-cruiser": "^18.4.0",
    "three": "^0.186.1",
    "typescript": "~5.9",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11"
  }
}
